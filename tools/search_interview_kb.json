{
  "name": "search_interview_kb",
  "description": "查询模拟面试知识库。返回资料片段、类型、标题、来源链接和审核状态。回答专业问题时优先查询 professional，出题和追问时查询 interview，简历追问时查询 personal，复盘时查询 practice。",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {"type": "string", "description": "要查找的问题或关键词"},
      "kind": {"type": "string", "enum": ["professional", "interview", "personal", "practice"]},
      "limit": {"type": "integer", "minimum": 1, "maximum": 30, "default": 5}
    },
    "required": ["query"],
    "additionalProperties": false
  },
  "handler": {"method": "GET", "url": "http://127.0.0.1:8765/v1/search", "mapping": {"query": "q", "kind": "kind", "limit": "limit"}}
}
